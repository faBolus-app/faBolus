// faBolus — shared build configuration (committed).
//
// You normally do NOT edit this file. To build under your own Apple account,
// copy  LocalConfig.xcconfig.example → LocalConfig.xcconfig  and set your values
// there. LocalConfig.xcconfig is gitignored, so your Team ID and bundle ID stay
// on your machine and are never committed.

// The single source of truth for identifiers. Every other bundle ID — the watch
// app, the widgets, the shared App Group, the deep-link URL names — is derived
// from this one value in project.yml. Change it in LocalConfig.xcconfig, not here.
APP_BUNDLE_ID = com.fabolus.app

// App version, single-sourced here the same way as APP_BUNDLE_ID: every target inherits these two
// values from the project-level configFiles (project.yml) rather than repeating them. MARKETING_VERSION
// is the user-facing CFBundleShortVersionString (semver); CURRENT_PROJECT_VERSION is the build number
// (CFBundleVersion). Bump MARKETING_VERSION on a release and record it in CHANGELOG.md. The watch app
// carries the same version: faBolusGarmin's scripts/check-version-sync.sh fails when its AppVersion.NAME
// differs from MARKETING_VERSION here, at the faBolus commit in its contract/PIN. The poll golden fixtures
// (RemoteProtocol's GoldenFixtures.swift) carry it as the watch's appVersion: bump them with it and
// rewrite the contract (CONTRIBUTING.md); the contract gate fails until they match.
MARKETING_VERSION = 0.4.0
CURRENT_PROJECT_VERSION = 1

// Your 10-character Apple Developer Team ID. Leave blank to pick a Team in Xcode's
// Signing & Capabilities UI instead. (Xcode → Settings → Accounts → your team, or
// developer.apple.com → Account → Membership.)
DEVELOPMENT_TEAM =

// Connect IQ app id the phone pairs with (dashed UUID). Defaults to the watch app's own id, which a
// sideloaded build has. If you upload your own private beta (faBolusGarmin/scripts/beta-build.sh — the
// store requires a unique id per beta), set this to the id that script prints, in LocalConfig.xcconfig
// (the script does it for you).
GARMIN_BETA_APP_ID = A1B2C3D4-E5F6-0011-2233-445566778899

// Local, gitignored overrides win over the defaults above. Keep this the last line.
#include? "LocalConfig.xcconfig"
