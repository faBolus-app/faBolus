<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>group.$(APP_BUNDLE_ID)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>faBolus</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleSpokenName</key>
	<string>Fabolus</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID).ciq</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fabolusciq</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID).deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fabolus</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>GarminBetaAppID</key>
	<string>$(GARMIN_BETA_APP_ID)</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppNameKey</key>
			<string>faBolus</string>
		</dict>
		<dict>
			<key>INAlternativeAppNameKey</key>
			<string>Pump Remote</string>
		</dict>
		<dict>
			<key>INAlternativeAppNameKey</key>
			<string>Fabolus</string>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>gcm-ciq</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>faBolus connects to your pump over Bluetooth to read status and deliver boluses.</string>
	<key>NSCameraUsageDescription</key>
	<string>faBolus uses the camera to scan a pairing QR code when connecting to another phone as a remote, and to scan food barcodes for a carb estimate you review — it never doses for you.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>faBolus can read glucose from Apple Health as a backup CGM feed (e.g. from xDrip4iOS or Eversense) when the pump's glucose is unavailable. faBolus may also read your heart rate to show it as optional chart context in the glucose detail readout — heart rate is never used for dosing.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>faBolus can learn the places you usually eat (on your device only) so it can skip eating reminders when you're clearly somewhere else. Optional and off by default.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
