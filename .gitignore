.DS_Store
DerivedData/
build/
*.xcuserstate
xcuserdata/
.swiftpm/
Package.resolved
# Connect IQ
*.iq
bin/
gen/

# Personal signing config — copy LocalConfig.xcconfig.example to create it.
LocalConfig.xcconfig

# Generated by XcodeGen (project.yml is the source of truth)
*.xcodeproj/
ios/.build/
.build/

# MkDocs (docs site is built by CI; build locally with mkdocs serve)
site/
.venv/
.docvenv/

# The `build/` rule above is for Xcode output — do NOT let it swallow the docs build guide.
!docs/build/

# Derived xcodegen spec from scripts/generate-project.sh
project.generated.yml

# ML model binaries (bundled locally / shipped as release assets, not committed)
*.mlpackage
*.mlmodel
*.mlmodelc

# §1.3 version-pin: track the root-level canonical Package.resolved so every clone/CI run resolves
# the exact pinned TandemKit + faBolusNudge/LoopAlgorithm graph (D-04). Only negates the root copy —
# it cannot and must not reach the generated copy under the still-excluded *.xcodeproj/ tree.
!/Package.resolved

# Local dispatch-isolation runtime state — re-created per session, never a repo artifact.
.gsd/
