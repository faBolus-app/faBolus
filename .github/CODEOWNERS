# Code ownership → review routing. GitHub requests review from the owner automatically on any PR that
# touches a matching path. This is a small, single-maintainer project, so the default owner is the
# maintainer; the point of the specific rules below is to make the SAFETY-CRITICAL and CONTRACT paths
# impossible to change without that being visible in the review, not to distribute ownership.

# Default owner for everything.
*                                   @zgranowitz

# The phone↔remote contract. faBolusGarmin vendors these files from a pinned commit, so a change here
# reaches the watch; the golden fixtures test real messages, but the semantics are a human-review concern.
/Packages/RemoteProtocol/           @zgranowitz

# Safety-critical core: the dose composer, the access policy and the durable idempotency ledger. Dosing
# changes get extra review (CONTRIBUTING.md).
/Packages/faBolusCore/Sources/faBolusCore/DoseComposer.swift          @zgranowitz
/Packages/faBolusCore/Sources/faBolusCore/DoseComposer+Phone.swift    @zgranowitz
/Packages/faBolusCore/Sources/faBolusCore/DoseComposer+Remote.swift   @zgranowitz
/Packages/faBolusCore/Sources/faBolusCore/AccessPolicy.swift          @zgranowitz
/Packages/faBolusCore/Sources/faBolusCore/RemoteBolusLedger.swift     @zgranowitz
/Packages/faBolusCore/Sources/faBolusCore/RemoteBolusLedgerStore.swift @zgranowitz

# The one owner of the pump, the watch's way in to it, and the app state.
/Packages/PumpSession/                                @zgranowitz
/Packages/WatchLink/Sources/RemoteHost/               @zgranowitz
/Packages/PhoneApp/Sources/PhoneApp/AppModel.swift    @zgranowitz

